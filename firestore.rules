rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid} (Firebase Auth UID)
    // Fields:
    //   - draft: string (required on write, max 100000 chars) - composer draft
    //   - updatedAt: number (required on write) - draft last-write ms epoch
    //   - discussion: list (optional, max 40 turns) - composer reflection thread
    //   - historyTastes: number (optional, 0..100) - leftover field; unused by the app
    //   - journalLockSalt: string (optional) - base64 salt for client-side journal encryption
    //   - journalLockVerifier: string (optional) - encrypted verifier for the journal passcode

    //
    // Collection: users/{uid}/nuggets
    // Document ID: client-generated id
    // Fields:
    //   - text: string (required, 1..100000 chars) - journal entry body
    //   - createdAt: number (required, immutable) - ms epoch
    //   - discussion: list (optional, max 40 turns) - saved reflection thread
    //
    // Discussion turn fields:
    //   - id: string
    //   - comment: string (optional) - user reply that steered this turn
    //   - reflection: map (optional) with text + optional historyCite
    //   - usedHistory: bool (optional) - this turn included past entries
    //
    // Collection: users/{uid}/billing/current
    // Fields (Admin SDK only):
    //   - plan: 'clear-head' | 'pattern' | 'forever'
    //   - status: 'active' | 'past_due' | 'cancelled' | 'expired' | 'none'
    //   - lemonSubscriptionId, lemonCustomerId, lemonVariantId (optional)
    //   - renewsAt, endsAt, portalUrl (optional)
    //   - updatedAt: number
    //
    // Collection: users/{uid}/usage/daily
    // Fields (Admin SDK only):
    //   - dayKey: string (UTC YYYY-MM-DD)
    //   - reflections: number (free reflections used today)
    //   - chats: number (free chat replies used today)
    //   - updatedAt: number
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidDiscussion(data) {
      return data is list
        && data.size() > 0
        && data.size() <= 40;
    }

    function isValidUserDoc(data) {
      return data.keys().hasOnly(['draft', 'updatedAt', 'discussion', 'historyTastes', 'journalLockSalt', 'journalLockVerifier'])
        && data.draft is string
        && data.draft.size() <= 100000
        && data.updatedAt is number
        && (!('discussion' in data) || isValidDiscussion(data.discussion))
        && (!('historyTastes' in data)
          || (data.historyTastes is int
            && data.historyTastes >= 0
            && data.historyTastes <= 100))
        && (!('journalLockSalt' in data)
          || (data.journalLockSalt is string && data.journalLockSalt.size() <= 256))
        && (!('journalLockVerifier' in data)
          || (data.journalLockVerifier is string && data.journalLockVerifier.size() <= 512));
    }

    function isValidNugget(data) {
      return data.keys().hasOnly(['text', 'createdAt', 'discussion'])
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 100000
        && data.createdAt is number
        && (!('discussion' in data) || isValidDiscussion(data.discussion));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUserDoc(request.resource.data);
      allow update: if isOwner(uid) && isValidUserDoc(request.resource.data);
      allow delete: if isOwner(uid);

      match /nuggets/{nuggetId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidNugget(request.resource.data);
        allow update: if isOwner(uid)
          && isValidNugget(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      // Written only by journal42-api (Admin SDK). Clients may read their plan.
      match /billing/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Written only by journal42-api (Admin SDK). Clients may read remaining quota.
      match /usage/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
