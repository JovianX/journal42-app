# Firebase web app config (Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Reflection API base URL (no trailing slash)
# Dev default: http://localhost:8787
# Prod default: https://api.journal42.cloud
# Leave blank to use the mode default, or set explicitly to override.
VITE_AI_API_BASE=

# Meta (Facebook) Pixel ID from Events Manager
# Defaults to 1957935677758041 if unset in production.
VITE_META_PIXEL_ID=1957935677758041
